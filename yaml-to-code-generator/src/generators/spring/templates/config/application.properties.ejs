<%# config/application.properties.ejs — Spring Boot configuration %>
spring.application.name=<%= ir.application.module %>

# H2 In-Memory Database (PostgreSQL-ready)
spring.datasource.url=jdbc:h2:mem:<%= ir.application.module %>
spring.datasource.driverClassName=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=

# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.H2Dialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false

# Jackson (ISO dates instead of arrays)
spring.jackson.serialization.write-dates-as-timestamps=false

# H2 Console (dev only)
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# Server
server.port=8080

# CORS (development)
app.cors.allowed-origins=http://localhost:5173

# Future PostgreSQL config (uncomment to migrate):
# spring.datasource.url=jdbc:postgresql://localhost:5432/<%= ir.application.module %>
