<%# controller/EntityController.java.ejs — REST controller %><%
const gen = genEntities?.[entity.name];

const needsMap = gen.endpoints.some(ep => ep.needsMap);
const needsList = gen.endpoints.some(ep => ep.returnType.startsWith('List<'));
const needsHttpStatus = gen.serviceMethods.some(m => m.name === 'create' || m.name === 'addComment');
const needsCursorPage = gen.endpoints.some(ep => ep.returnType.includes('CursorPageDTO'));
const needsMinMax = gen.endpoints.some(ep => ep.params?.includes('@Min'));

// Collect all DTO class names referenced in return types (generic params, etc.)
// excluding the entity's own DTO which is always imported
const dtoRefs = new Set();
for (const ep of gen.endpoints) {
  const matches = ep.returnType.matchAll(/[A-Z]\w+DTO/g);
  for (const m of matches) {
    if (m[0] !== entity.namePascal + 'DTO') dtoRefs.add(m[0]);
  }
}
%>
package <%= ir.application.basePackage %>.controller;

import <%= ir.application.basePackage %>.dto.<%= entity.namePascal %>DTO;
import <%= ir.application.basePackage %>.service.<%= entity.namePascal %>Service;
<% for (const attr of entity.attributes.filter(a => a.isEnum)) { %>
import <%= ir.application.basePackage %>.entity.<%= attr.type %>;
<% } %>
<% if (gen.serviceMethods.some(m => m.name === 'addComment')) { %>
import <%= ir.application.basePackage %>.dto.CommentDTO;
<% } %>
<% if (needsCursorPage) { %>
import <%= ir.application.basePackage %>.dto.CursorPageDTO;
<% } %>
<% for (const dtoName of dtoRefs) { %>
import <%= ir.application.basePackage %>.dto.<%= dtoName %>;
<% } %>
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;
<% if (needsHttpStatus) { %>
import org.springframework.http.HttpStatus;
<% } %>
<% if (needsList) { %>
import java.util.List;
<% } %>
<% if (needsMap) { %>
import java.util.Map;
<% } %>
<% if (needsMinMax) { %>
import jakarta.validation.constraints.Min;
import jakarta.validation.constraints.Max;
<% } %>

@RestController
@RequestMapping("/api/<%= entity.nameKebab %>s")
@RequiredArgsConstructor
public class <%= entity.namePascal %>Controller {

    private final <%= entity.namePascal %>Service <%= entity.nameCamel %>Service;

<% for (let i = 0; i < entity.useCases.length; i++) { const uc = entity.useCases[i]; const ep = gen.endpoints[i]; %>
<% if (uc.httpMethod === 'GET') { %>
    <%= ep.annotation %><% if (ep.path) { %>("<%- ep.path %>")<% } %>
    public ResponseEntity<<%- ep.returnType %>> <%= uc.methodName %>(<%- ep.params %>) {
        <%- ep.body || `return ResponseEntity.ok(${entity.nameCamel}Service.${uc.methodName}());` %>
    }

<% } else if (uc.httpMethod === 'POST') { %>
    <%= ep.annotation %><% if (ep.path) { %>("<%- ep.path %>")<% } %>
    public ResponseEntity<<%- ep.returnType %>> <%= uc.methodName %>(<%- ep.params %>) {
<%   if (ep.needsMap) { %>
        String bodyValue = body.get("<%= uc.methodName === 'addComment' ? 'text' : '' %>");
        return ResponseEntity.status(HttpStatus.CREATED).body(<%= entity.nameCamel %>Service.<%= uc.methodName %>(id, bodyValue));
<%   } else { %>
        <%= entity.namePascal %>DTO created = <%= entity.nameCamel %>Service.<%= uc.methodName %>(dto);
        return ResponseEntity.status(HttpStatus.CREATED).body(created);
<%   } %>
    }

<% } else if (uc.httpMethod === 'PATCH') { %>
    <%= ep.annotation %><% if (ep.path) { %>("<%- ep.path %>")<% } %>
    public ResponseEntity<<%- ep.returnType %>> <%= uc.methodName %>(
            @PathVariable <%= gen.pkJavaType %> id,
            @RequestBody Map<String, String> body) {
<%   const statusEnum = entity.attributes.find(a => a.isEnum && a.name === 'status'); %>
<%   const priorityEnum = entity.attributes.find(a => a.isEnum && a.name === 'priority'); %>
<%   if (statusEnum && uc.methodName === 'updateStatus') { %>
        return ResponseEntity.ok(<%= entity.nameCamel %>Service.<%= uc.methodName %>(id, body.get("status")));
<%   } else if (priorityEnum && uc.methodName === 'updatePriority') { %>
        return ResponseEntity.ok(<%= entity.nameCamel %>Service.<%= uc.methodName %>(id, body.get("priority")));
<%   } else { %>
        return ResponseEntity.ok(<%= entity.nameCamel %>Service.<%= uc.methodName %>(id, body));
<%   } %>
    }

<% } else if (uc.httpMethod === 'PUT') { %>
    <%= ep.annotation %><% if (ep.path) { %>("<%- ep.path %>")<% } %>
    public ResponseEntity<<%- ep.returnType %>> <%= uc.methodName %>(
            @PathVariable <%= gen.pkJavaType %> id,
            @RequestBody Map<String, String> body) {
        String val = body.get("<%= uc.methodName === 'assignUser' ? 'userId' : 'value' %>");
        return ResponseEntity.ok(<%= entity.nameCamel %>Service.<%= uc.methodName %>(id, val));
    }

<% } else if (uc.httpMethod === 'DELETE') { %>
    <%= ep.annotation %><% if (ep.path) { %>("<%- ep.path %>")<% } %>
    public ResponseEntity<<%- ep.returnType %>> <%= uc.methodName %>(@PathVariable <%= gen.pkJavaType %> id) {
        return ResponseEntity.ok(<%= entity.nameCamel %>Service.<%= uc.methodName %>(id));
    }

<% } %>
<% } %>
}
