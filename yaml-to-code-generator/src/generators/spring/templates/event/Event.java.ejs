<%# event/Event.java.ejs — Event class (one per event type) %>
<% const srcEntity = ir.entities.find(e => e.name === event.source);
   const entityType = srcEntity ? srcEntity.namePascal : null;
   const trackedSuffixes = ['Creado', 'Asignado', 'Cerrado', 'Modificado', 'Desasignado'];
   // Tracked mode (old/new/actor) is needed for entity events that the builder
   // will call with 3 args (oldEntity, newEntity, actor). Enable it by default
   // when the event has a source entity matching a known action suffix.
   const isTracked = (event.trackedFields && event.trackedFields.length > 0)
       || (entityType && trackedSuffixes.some(s => event.namePascal.endsWith(s))); %>
package <%= ir.application.basePackage %>.event;

<% if (entityType) { %>import <%= ir.application.basePackage %>.entity.<%= entityType %>;
<% } %>import lombok.Getter;
import org.springframework.context.ApplicationEvent;

@Getter
public class <%= event.name %>Event extends ApplicationEvent {
<% if (entityType && isTracked) { %>
    private final <%= entityType %> oldEntity;
    private final <%= entityType %> newEntity;
    private final String actor;
<% } else if (entityType) { %>
    private final <%= entityType %> entity;
<% } else { %>
    private final String entityId;
<% for (const field of event.payload) { %>
    private final <%= field.type %> <%= field.name %>;
<% } %>
<% } %>

<% if (entityType && isTracked) { %>
    public <%= event.name %>Event(Object source, <%= entityType %> oldEntity, <%= entityType %> newEntity, String actor) {
        super(source);
        this.oldEntity = oldEntity;
        this.newEntity = newEntity;
        this.actor = actor;
    }
<% } else if (entityType) { %>
    public <%= event.name %>Event(Object source, <%= entityType %> entity) {
        super(source);
        this.entity = entity;
    }
<% } else { %>
    public <%= event.name %>Event(Object source, String entityId<% for (const field of event.payload) { %>, <%= field.type %> <%= field.name %><% } %>) {
        super(source);
        this.entityId = entityId;
<% for (const field of event.payload) { %>
        this.<%= field.name %> = <%= field.name %>;
<% } %>
    }
<% } %>
}
