/* Layout utilities */
.list-view {
  max-width: var(--content-max-width, 800px);
  margin: 0 auto;
  padding: var(--space-xl, 20px);
}

.detail-view {
  max-width: var(--content-max-width, 800px);
  margin: 0 auto;
  padding: var(--space-xl, 20px);
}

.create-view {
  max-width: 600px;
  margin: 0 auto;
  padding: var(--space-xl, 20px);
}

.list-view header,
.detail-view header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-lg, 16px);
}

/* Buttons */
.btn-primary {
  padding: var(--space-sm, 8px) var(--space-lg, 16px);
  background: var(--color-primary, #42b883);
  color: white;
  border: none;
  border-radius: var(--radius-sm, 4px);
  cursor: pointer;
  transition: background var(--transition-fast, 150ms ease);
}

.btn-primary:hover {
  background: color-mix(in srgb, var(--color-primary, #42b883) 80%, black);
}

.btn-back {
  padding: var(--space-sm, 8px) var(--space-lg, 16px);
  background: transparent;
  border: 1px solid var(--color-border, #ddd);
  border-radius: var(--radius-sm, 4px);
  cursor: pointer;
  margin-bottom: var(--space-lg, 16px);
  transition: border-color var(--transition-fast, 150ms ease);
}

.btn-back:hover {
  border-color: var(--color-primary, #42b883);
}

/* Error state */
.error {
  color: var(--color-danger, #dc3545);
}

/* Meta info row */
.meta {
  display: flex;
  gap: var(--space-lg, 16px);
  margin: var(--space-lg, 16px) 0;
}

/* Description text */
.description {
  color: var(--color-text-secondary, #666);
  margin: var(--space-md, 12px) 0;
}

/* Form utilities */
.form-group {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs, 4px);
}

.entity-form {
  display: flex;
  flex-direction: column;
  gap: var(--space-md, 12px);
}

/* Responsive grid for list views */
.list-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md, 12px);
}

/* Mobile-first responsive breakpoints */
@media (min-width: 768px) {
  .list-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .create-view,
  .detail-view,
  .list-view {
    padding: var(--space-2xl, 24px);
  }
}

@media (min-width: 1024px) {
  .list-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 576px) {
  .list-view,
  .detail-view,
  .create-view {
    padding: var(--space-md, 12px);
  }
  .btn-primary,
  .btn-back {
    width: 100%;
  }
  .meta {
    flex-direction: column;
  }
}

/* Skip link at top of AppShell.vue targets #main-content within the same component */
.skip-link {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.skip-link:focus {
  clip: auto;
  position: fixed;
  top: 8px;
  left: 8px;
  z-index: 9999;
  padding: 8px 16px;
  background: var(--color-primary, #42b883);
  color: white;
  border-radius: 4px;
  font-weight: 600;
  text-decoration: none;
}
