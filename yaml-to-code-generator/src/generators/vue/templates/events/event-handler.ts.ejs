<%-`// ${event.name}.handler.ts — Generated from helpdesk.yaml`%>

export interface <%= event.name %>Payload {
<% for (const field of event.payload) { -%>
  <%= field.name %><%= field.required ? '' : '?' %>: <%= field.type %>;
<% } -%>
}

export type <%= event.name %>Handler = (payload: <%= event.name %>Payload) => void | Promise<void>;

const handlers: Map<string, <%= event.name %>Handler[]> = new Map();

export function on<%= event.name %>(handler: <%= event.name %>Handler): () => void {
  const id = '<%= event.name %>';
  if (!handlers.has(id)) handlers.set(id, []);
  const list = handlers.get(id)!;
  list.push(handler);
  return () => {
    const idx = list.indexOf(handler);
    if (idx >= 0) list.splice(idx, 1);
  };
}

export async function emit<%= event.name %>(payload: <%= event.name %>Payload): Promise<void> {
  const id = '<%= event.name %>';
  const list = handlers.get(id);
  if (!list) return;
  for (const handler of list) {
    await handler(payload);
  }
}
