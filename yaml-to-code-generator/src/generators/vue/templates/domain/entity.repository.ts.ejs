<%
const gen = genEntities?.[entity.name];
-%><%-`// ${entity.nameCamel}.repository.ts — Generated from helpdesk.yaml`%>
import type { <%= entity.namePascal %> } from './<%= entity.nameCamel %>.types';
<% if (gen?.enumAttributes?.length) { -%>
import type { <%= gen.enumAttributes.map(a => a.type).join(', ') %> } from './<%= entity.nameCamel %>.types';
<% } -%>
<% if (gen?.hasCommentSupport && gen.commentEntity && gen.commentEntity.nameCamel !== entity.nameCamel) { -%>
import type { Comment } from '../<%= gen.commentEntity.nameCamel %>/<%= gen.commentEntity.nameCamel %>.types';
<% } -%>
<% if (gen?.hasActivityLog && gen?.activityLogEntity) { -%>
import type { <%= gen.activityLogEntity.namePascal %> } from '../<%= gen.activityLogEntity.nameCamel %>/<%= gen.activityLogEntity.nameCamel %>.types';
import type { PaginatedResponse } from '../../infrastructure/api-client';
<% } -%>

export interface <%= entity.namePascal %>Repository {
<% for (const uc of entity.useCases) {
  const ucGen = gen?.useCases?.[uc.name];
  if (!ucGen) continue;
-%>
  <%= uc.methodName %>(<%- ucGen.methodSignature.params %>): Promise<<%- ucGen.methodSignature.returnType %>>;
<% } -%>
}
