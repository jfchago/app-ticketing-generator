<%# components/StatusBadge.vue.ejs — Status badge component %>
<%
const gen = genEntities?.[entity.name];
const statusAttr = gen?.enumAttributes?.find(ea => ea.name === 'status');
const statusColorMap = [
  { keywords: ['open', 'active', 'pending'], bg: 'var(--color-primary-light)', color: 'var(--color-primary-text)' },
  { keywords: ['in_progress', 'processing'], bg: 'var(--color-warning-light)', color: 'var(--color-warning-text)' },
  { keywords: ['resolved', 'completed', 'done'], bg: 'var(--color-success-light)', color: 'var(--color-success-text)' },
  { keywords: ['closed', 'cancelled', 'rejected'], bg: 'var(--color-neutral-light)', color: 'var(--color-neutral-text)' },
  { keywords: ['on_hold', 'blocked', 'waiting'], bg: 'var(--color-info-light)', color: 'var(--color-info-text)' },
];
function statusStyle(valueName) {
  const lower = valueName.toLowerCase();
  for (const entry of statusColorMap) {
    if (entry.keywords.includes(lower)) return entry;
  }
  return { bg: 'var(--color-neutral-light)', color: 'var(--color-neutral-text)' };
}
%>
<script setup lang="ts">
defineProps<{ status: string; }>();
</script>

<template>
  <span class="status-badge" :class="'status-' + status.toLowerCase()">{{ status }}</span>
</template>

<style scoped>
.status-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 600; }
<% if (statusAttr) { for (const v of statusAttr.values) { const style = statusStyle(v.name); %>
.status-<%= v.name.toLowerCase() %> { background: <%- style.bg %>; color: <%- style.color %>; }
<% } } %>
</style>
