<%# components/EntityForm.vue.ejs — Create/edit form component %>
<script setup lang="ts">
import { ref, computed } from 'vue';
import FormField from '../components/FormField.vue';
import type { <%= entity.namePascal %> } from '../domain/<%= entity.nameCamel %>/<%= entity.nameCamel %>.types';
<% const enumAttrs = entity.attributes.filter(a => a.isEnum); if (enumAttrs.length > 0) { %>
import type { <%- enumAttrs.map(a => a.type).join(', ') %> } from '../domain/<%= entity.nameCamel %>/<%= entity.nameCamel %>.types';
import { <%- enumAttrs.map(a => `${a.type}_LABELS`).join(', ') %> } from '../domain/<%= entity.nameCamel %>/<%= entity.nameCamel %>.types';
<% } %>
<% const fkAttrs = entity.attributes.filter(a => entity.relationships.some(r => r.foreignKey === a.name)); if (fkAttrs.length > 0) { %>
import { onMounted } from 'vue';
<% for (const attr of fkAttrs) { 
  const rel = entity.relationships.find(r => r.foreignKey === attr.name);
  const targetEntity = rel ? ir.entities.find(e => e.name === rel.target) : null;
  if (targetEntity) { %>
import { use<%- targetEntity.namePascal %>Store } from '../stores/<%- targetEntity.nameCamel %>.store';
const <%- targetEntity.nameCamel %>Store = use<%- targetEntity.namePascal %>Store();
<%   } 
} %>
onMounted(() => {
<% for (const attr of fkAttrs) { 
  const rel = entity.relationships.find(r => r.foreignKey === attr.name);
  const targetEntity = rel ? ir.entities.find(e => e.name === rel.target) : null;
  if (targetEntity) { 
    const loadMethod = targetEntity.useCases?.find(uc => uc.name === 'load_users')?.methodName ?? 'loadUsers';
%>
  <%- targetEntity.nameCamel %>Store.<%- loadMethod %>();
<%   } 
} %>
});
<% } %>

<% const formAttrs = entity.attributes.filter(a => !a.primary && a.name !== 'createdAt' && a.name !== 'updatedAt' && a.name !== 'id' && !a.isEntityRef); %>

<% for (const attr of formAttrs) { %>
const <%= attr.name %> = ref<<%= attr.tsType %>><%- attr.defaultValue ? "('" + attr.defaultValue + "')" : attr.required ? "('')" : '(null)' %>;
<% } %>

const emit = defineEmits<{
  submit: [data: Partial<<%= entity.namePascal %>>];
}>();

const refs: Record<string, any> = {<% for (const attr of formAttrs) { %>
  <%= attr.name %>: <%= attr.name %>,<% } %>
};

const formFields = computed(() => [<% for (const attr of formAttrs) { %>
  {
    htmlId: '<%= attr.name %>',
    label: '<%= attr.label ?? attr.namePascal.replace(/([a-z])([A-Z])/g, '$1 $2') %>',
    type: <% if (attr.type === 'String' && (attr.length ?? 999) > 200) { %>'textarea' as const<% } else if (attr.isEnum) { %>'select' as const<% } else if (entity.relationships.some(r => r.foreignKey === attr.name)) { %>'fk-select' as const<% } else { %>'text' as const<% } %>,
    options: <% if (attr.isEnum) { %>Object.entries(<%= attr.type %>_LABELS).map(([value, label]) => ({ value, label }))<% } else if (entity.relationships.some(r => r.foreignKey === attr.name)) {
  const rel = entity.relationships.find(r => r.foreignKey === attr.name);
  const targetEntity = rel ? ir.entities.find(e => e.name === rel.target) : null;
  const targetCamel = targetEntity?.nameCamel ?? 'unknown';
  const displayField = targetEntity?.attributes.find(a => a.name === 'name')?.name ?? targetEntity?.attributes.find(a => !a.primary)?.name ?? 'id';
%>(<%- targetCamel %>Store.<%- targetCamel %>s || []).map(item => ({ value: item.id, label: item.<%- displayField %> }))<% } else { %>undefined<% } %>,
    required: <%= attr.required %>,
  },<% } %>
]);

function handleSubmit() {
  emit('submit', {<%_ const submitAttrs = entity.attributes.filter(a => !a.primary && a.name !== 'id' && a.name !== 'createdAt' && a.name !== 'updatedAt' && !a.isEntityRef); for (let i = 0; i < submitAttrs.length; i++) { const a = submitAttrs[i]; _%>
    <%= a.name %>: <%= a.name %>.value<%= i < submitAttrs.length - 1 ? ',' : '' %>
<%_ } _%>
  });
}
</script>

<template>
  <form @submit.prevent="handleSubmit" class="entity-form">
    <fieldset>
      <legend><%= entity.namePascal %> Details</legend>
    <FormField
      v-for="field in formFields"
      :key="field.htmlId"
      v-model="refs[field.htmlId].value"
      v-bind="field"
    />
    </fieldset>
    <button type="submit" aria-label="Save <%= entity.namePascal %>">Save</button>
  </form>
</template>

<style scoped>
.entity-form { display: flex; flex-direction: column; gap: 12px; max-width: 500px; }
button { padding: 10px 16px; background: var(--color-primary, #42b883); color: white; border: none; border-radius: 4px; cursor: pointer; }
@media (min-width: 768px) {
  .entity-form { max-width: 500px; }
}
@media (max-width: 576px) {
  button { width: 100%; min-height: 44px; min-width: 44px; }
  .form-group input, .form-group textarea, .form-group select { font-size: 16px; }
}
</style>
