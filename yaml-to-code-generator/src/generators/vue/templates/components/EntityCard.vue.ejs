<%# components/EntityCard.vue.ejs — List item card component %>
<%
const gen = genEntities?.[entity.name];
const textFields = gen?.displayFields?.filter(f => f.fieldRole === 'text') ?? [];
const primaryField = textFields[0];
const descField = textFields.length > 1 ? textFields[1] : null;
%>
<script setup lang="ts">
import type { <%= entity.namePascal %> } from '../domain/<%= entity.nameCamel %>/<%= entity.nameCamel %>.types';

defineProps<{
  item: <%= entity.namePascal %>;
}>();

defineEmits<{
  click: [id: string];
}>();
</script>

<template>
  <div class="card" role="button" tabindex="0" :aria-label="<% if (primaryField) { %>item.<%= primaryField.name %> ?? ''<% } else { %>String(item.id)<% } %>" @click="$emit('click', item.id)" @keydown.enter="$emit('click', item.id)" @keydown.space.prevent="$emit('click', item.id)">
<% if (primaryField) { %>
    <h3>{{ item.<%= primaryField.name %> }}</h3>
<% } else { %>
    <h3>{{ item.id }}</h3>
<% } %>
<% if (descField) { %>
    <p v-if="item.<%= descField.name %>">{{ item.<%= descField.name %> }}</p>
<% } %>
  </div>
</template>

<style scoped>
.card {
  border: 1px solid var(--color-border, #ddd);
  border-radius: 6px;
  padding: 12px;
  cursor: pointer;
}
.card:hover {
  border-color: var(--color-primary, #42b883);
}
</style>
