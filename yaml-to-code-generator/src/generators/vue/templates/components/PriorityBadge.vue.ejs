<%# components/PriorityBadge.vue.ejs — Priority badge component %>
<%
const gen = genEntities?.[entity.name];
const priorityAttr = gen?.enumAttributes?.find(ea => ea.name === 'priority');
const priorityColorMap = [
  { keywords: ['low', 'minor'], bg: 'var(--color-success-light)', color: 'var(--color-success)' },
  { keywords: ['medium', 'normal', 'moderate'], bg: 'var(--color-primary-light)', color: 'var(--color-primary)' },
  { keywords: ['high', 'major'], bg: 'var(--color-warning-light)', color: 'var(--color-warning)' },
  { keywords: ['urgent', 'critical', 'blocker'], bg: 'var(--color-danger-light)', color: 'var(--color-danger)' },
];
function priorityStyle(valueName) {
  const lower = valueName.toLowerCase();
  for (const entry of priorityColorMap) {
    if (entry.keywords.includes(lower)) return entry;
  }
  return { bg: 'var(--color-neutral-light)', color: 'var(--color-neutral)' };
}
%>
<script setup lang="ts">
defineProps<{ priority: string; }>();
</script>

<template>
  <span class="priority-badge" :class="'priority-' + priority.toLowerCase()">{{ priority }}</span>
</template>

<style scoped>
.priority-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.85em; font-weight: 600; }
<% if (priorityAttr) { for (const v of priorityAttr.values) { const style = priorityStyle(v.name); %>
.priority-<%= v.name.toLowerCase() %> { background: <%- style.bg %>; color: <%- style.color %>; }
<% } } %>
</style>
