<%# views/EntityDetailView.vue.ejs — Detail view for an entity %>
<%
const gen = genEntities?.[entity.name];
%>
<script setup lang="ts">
import { onMounted } from 'vue';
import { useRoute, useRouter } from 'vue-router';
import { use<%= entity.namePascal %>Store } from '../stores/<%= entity.nameCamel %>.store';
<% if (gen.components.shouldRenderStatusBadge) { %>
import StatusBadge from '../components/<%= entity.namePascal %>StatusBadge.vue';
<% } %>
<% if (gen.components.shouldRenderPriorityBadge) { %>
import PriorityBadge from '../components/<%= entity.namePascal %>PriorityBadge.vue';
<% } %>
<% if (gen.components.shouldRenderAssigneeBadge) { %>
import AssigneeBadge from '../components/<%= entity.namePascal %>AssigneeBadge.vue';
<% } %>

const store = use<%= entity.namePascal %>Store();
const route = useRoute();
const router = useRouter();

onMounted(() => {
  store.load<%= entity.namePascal %>(route.params.id as string);
});
</script>

<template>
  <div class="detail-view">
    <button @click="router.back()" class="btn-back">← Back</button>

    <div v-if="store.loading">Loading...</div>
    <div v-else-if="store.error" class="error">{{ store.error }}</div>
    <div v-else-if="store.<%= gen.selectedPropertyName %>">
<% if (gen.components.shouldRenderStatusBadge) { %>
      <h1>{{ store.<%= gen.selectedPropertyName %>.title }}</h1>
      <p class="description">{{ store.<%= gen.selectedPropertyName %>.description }}</p>

      <div class="meta">
        <span>Status: <StatusBadge :status="store.<%= gen.selectedPropertyName %>.status" /></span>
        <span>Priority: <PriorityBadge :priority="store.<%= gen.selectedPropertyName %>.priority" /></span>
        <span>Assigned to: <AssigneeBadge :assignee-id="store.<%= gen.selectedPropertyName %>.assigneeId" /></span>
        <span>Created: {{ new Date(store.<%= gen.selectedPropertyName %>.createdAt).toLocaleDateString() }}</span>
      </div>
<% } else { %>
      <pre>{{ JSON.stringify(store.<%= gen.selectedPropertyName %>, null, 2) }}</pre>
<% } %>
    </div>
  </div>
</template>

<style scoped>
.detail-view { max-width: 800px; margin: 0 auto; padding: 20px; }
.btn-back { padding: 8px 16px; background: transparent; border: 1px solid var(--color-border, #ddd); border-radius: 4px; cursor: pointer; margin-bottom: 16px; }
.description { color: var(--color-text-secondary, #666); margin: 12px 0; }
.meta { display: flex; gap: 16px; margin: 16px 0; }
.error { color: red; }
</style>
