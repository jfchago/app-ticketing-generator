<%# views/EntityListView.vue.ejs — List view for an entity %>
<%
const gen = genEntities?.[entity.name];
const readAction = gen?.storeActions?.find(a => a.actionCategory === 'read');
%>
<script setup lang="ts">
import { onMounted } from 'vue';
import { useRouter } from 'vue-router';
import { use<%= entity.namePascal %>Store } from '../stores/<%= entity.nameCamel %>.store';
import <%= entity.namePascal %>Card from '../components/<%= entity.namePascal %>Card.vue';
import LoaderSpinner from '../components/LoaderSpinner.vue';
import ErrorState from '../components/ErrorState.vue';
import EmptyState from '../components/EmptyState.vue';

const store = use<%= entity.namePascal %>Store();
const router = useRouter();

onMounted(() => {
<% if (readAction) { %>
  store.<%= readAction.name %>();
<% } else { %>
  store.getAll();
<% } %>
});

function retryLoad() {
<% if (readAction) { %>
  store.<%= readAction.name %>();
<% } else { %>
  store.getAll();
<% } %>
}

function goToDetail(id: string) {
  router.push('/<%= entity.nameKebab %>s/' + id);
}
<% if (entity.hasCreate) { %>
function goToCreate() {
  router.push('/<%= entity.nameKebab %>s/new');
}
<% } %>
</script>

<template>
  <div class="list-view">
    <header>
      <h1><%= entity.namePascal %>s</h1>
<% if (entity.hasCreate) { %>
      <button @click="goToCreate" class="btn-primary" aria-label="Create new <%= entity.namePascal %>">+ New <%= entity.namePascal %></button>
<% } %>
    </header>

    <div aria-live="polite">
    <LoaderSpinner v-if="store.loading" />
    <ErrorState v-else-if="store.error" :message="store.error" :retry-fn="retryLoad" />
    <EmptyState v-else-if="store.<%= gen.statePropertyName %>.length === 0" :entity-name="'<%= entity.namePascal %>'" />
    <div v-else class="card-grid">
      <<%= entity.namePascal %>Card
        v-for="item in store.<%= gen.statePropertyName %>"
        :key="item.id"
        :item="item"
        @click="goToDetail"
      />
    </div>
    </div>
  </div>
</template>

<style scoped>
.card-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md, 12px);
}
@media (min-width: 768px) {
  .card-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .card-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
</style>
