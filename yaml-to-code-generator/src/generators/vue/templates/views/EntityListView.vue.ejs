<%# views/EntityListView.vue.ejs — List view for an entity %>
<%
const gen = genEntities?.[entity.name];
const readAction = gen?.storeActions?.find(a => a.actionCategory === 'read');
%>
<script setup lang="ts">
import { onMounted } from 'vue';
import { useRouter } from 'vue-router';
import { use<%= entity.namePascal %>Store } from '../stores/<%= entity.nameCamel %>.store';
import <%= entity.namePascal %>Card from '../components/<%= entity.namePascal %>Card.vue';

const store = use<%= entity.namePascal %>Store();
const router = useRouter();

onMounted(() => {
<% if (readAction) { %>
  store.<%= readAction.name %>();
<% } else { %>
  store.getAll();
<% } %>
});

function goToDetail(id: string) {
  router.push('/<%= entity.nameKebab %>s/' + id);
}
<% if (entity.hasCreate) { %>
function goToCreate() {
  router.push('/<%= entity.nameKebab %>s/new');
}
<% } %>
</script>

<template>
  <div class="list-view">
    <header>
      <h1><%= entity.namePascal %>s</h1>
<% if (entity.hasCreate) { %>
      <button @click="goToCreate" class="btn-primary">+ New <%= entity.namePascal %></button>
<% } %>
    </header>

    <div v-if="store.loading">Loading...</div>
    <div v-else-if="store.error" class="error">{{ store.error }}</div>
    <div v-else>
      <<%= entity.namePascal %>Card
        v-for="item in store.<%= gen.statePropertyName %>"
        :key="item.id"
        :item="item"
        @click="goToDetail"
      />
    </div>
  </div>
</template>

